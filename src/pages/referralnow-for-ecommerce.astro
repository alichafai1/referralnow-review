---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Cta from '../components/Cta.astro';

const title = 'ReferralNow for E-commerce: Turn Buyers into Brand Advocates';
const description =
	'ReferralNow for ecommerce stores. Turn a one-time Shopify or WooCommerce buyer into an advocate with a tracked link, a fraud check, and a $49 one-time software fee.';
const canonicalURL = new URL('/referralnow-for-ecommerce', Astro.site).href;

const checks = [
	'Works with Shopify and WooCommerce',
	'No monthly software fee',
	'Real sale verification before a reward',
];

const faqs = [
	{
		q: 'Does ReferralNow plug into Shopify and WooCommerce?',
		a: 'Yes. Both connect directly. BigCommerce, Wix, and Squarespace do too. A paid order can confirm with the real order value, and the friend can get a single-use discount.',
	},
	{
		q: 'What does the buyer receive after checkout?',
		a: 'A personal link and code. There is no app to download. When a friend buys through that link, the sale is confirmed before the original buyer is rewarded.',
	},
	{
		q: 'Is the $49 a monthly app fee?',
		a: 'No. The launch price is $49 once. You still pay the rewards you promise, such as a discount or store credit. Cash and gift cards are a Pro upgrade.',
	},
	{
		q: 'Will this stop fake referrals on my store?',
		a: 'Every claim gets a fraud score before a reward moves. Self-referrals and suspicious bursts can be blocked. A refunded order is held through your refund window so it does not pay out.',
	},
];

const crumbs = [
	{ name: 'Home', href: '/' },
	{ name: 'For ecommerce', href: '/referralnow-for-ecommerce' },
];

const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'FAQPage',
			mainEntity: faqs.map((item) => ({
				'@type': 'Question',
				name: item.q,
				acceptedAnswer: { '@type': 'Answer', text: item.a },
			})),
		},
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
				{ '@type': 'ListItem', position: 2, name: 'For ecommerce', item: canonicalURL },
			],
		},
	],
};
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL} schema={schema}>
	<section class="hero hero-plain">
		<div class="container">
			<Breadcrumbs items={crumbs} includeSchema={false} />
			<p class="eyebrow">Shopify and WooCommerce · $49 once</p>
			<h1>ReferralNow for E-commerce: Turn One-Time Buyers into Repeat Advocates</h1>
			<p class="subhead">
				Facebook and TikTok ads keep getting more expensive. A buyer who already likes the product can
				bring the next order. ReferralNow is how you track that word of mouth instead of hoping it
				shows up in the ads manager.
			</p>
			<Cta class="btn btn-lg hero-cta" label="Get ReferralNow Premium for $49 →" />
			<p class="page-links">
				<a href="/">Read our full <strong>ReferralNow Premium Review</strong> →</a>
				<a href="/referralnow-pricing">See the <strong>ReferralNow Premium Pricing</strong> →</a>
				<a href="/referralnow-bonus">Claim your <strong>Exclusive Bonuses</strong> →</a>
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container narrow">
			<h2 class="section-heading">The problem: you pay to acquire a customer who buys once</h2>
			<ul class="pain-list">
				<li>
					<span class="mark mark-no" aria-hidden="true">✕</span>
					<span>A $30 ad click can buy a first order and then go quiet.</span>
				</li>
				<li>
					<span class="mark mark-no" aria-hidden="true">✕</span>
					<span>Happy buyers already tell friends. The store never sees which order came from that chat.</span>
				</li>
				<li>
					<span class="mark mark-no" aria-hidden="true">✕</span>
					<span>A monthly referral app adds another bill on top of the ads.</span>
				</li>
			</ul>
			<Cta class="btn section-cta" label="Get ReferralNow Premium for $49 →" />
		</div>
	</section>

	<section class="section section-alt">
		<div class="container">
			<h2 class="section-heading">The store loop</h2>
			<div class="package-grid">
				<article class="card">
					<p class="rank-kicker">After checkout</p>
					<h3>The buyer gets a link</h3>
					<p>Shopify or WooCommerce connects directly. The customer gets one link and one code. No app.</p>
				</article>
				<article class="card">
					<p class="rank-kicker">When a friend buys</p>
					<h3>The order confirms itself</h3>
					<p>The friend can get a single-use discount. A paid order confirms with the real order value.</p>
				</article>
				<article class="card">
					<p class="rank-kicker">Before anyone is paid</p>
					<h3>The claim is checked</h3>
					<p>A fraud score runs first. Rewards wait through your refund window.</p>
				</article>
				<article class="card">
					<p class="rank-kicker">The software price</p>
					<h3>$49 once</h3>
					<p>No monthly software fee on this plan. You still fund the discount or store credit you promised.</p>
				</article>
			</div>
			<Cta class="btn btn-lg section-cta" label="Connect your store for $49 →" />
		</div>
	</section>

	<section class="section">
		<div class="container narrow">
			<h2 class="section-heading">What ecommerce owners get</h2>
			<ul class="check-list">
				{
					checks.map((item) => (
						<li>
							<span class="mark mark-yes" aria-hidden="true">✓</span>
							<span>{item}</span>
						</li>
					))
				}
			</ul>
			<Cta class="btn section-cta" label="Lock in ReferralNow for $49 →" />
		</div>
	</section>

	<section class="section section-alt" id="faq">
		<div class="container">
			<h2 class="section-heading">Ecommerce questions</h2>
			<div class="faq-list">
				{
					faqs.map((item) => (
						<details class="faq-item">
							<summary>{item.q}</summary>
							<p>{item.a}</p>
						</details>
					))
				}
			</div>
			<Cta class="btn btn-lg section-cta" label="Get ReferralNow Premium for $49 →" />
		</div>
	</section>

	<section class="final-band">
		<div class="container">
			<h2 class="section-heading">Let the last buyer bring the next one</h2>
			<p class="subhead">
				Track the referral, check the order, and stop paying a monthly app fee for the privilege.
			</p>
			<Cta class="btn btn-lg" label="Get ReferralNow Premium + My Bonuses →" />
			<p class="page-links">
				<a href="/">Read the <strong>ReferralNow Premium Review</strong> →</a>
				<a href="/referralnow-pricing">See <strong>ReferralNow Premium Pricing</strong> →</a>
				<a href="/referralnow-bonus">Claim your <strong>Exclusive Bonuses</strong> →</a>
			</p>
		</div>
	</section>

	<aside class="sticky-cta" aria-label="Get ReferralNow Premium" hidden>
		<p>Shopify and WooCommerce · $49 once</p>
		<Cta class="btn" label="Get ReferralNow Premium for $49 →" />
	</aside>
	<script>
		const bar = document.querySelector('.sticky-cta');
		const trigger = document.querySelector('.hero-cta');
		if (bar instanceof HTMLElement && trigger) {
			new IntersectionObserver(([entry]) => {
				bar.hidden = entry.isIntersecting;
			}).observe(trigger);
		}
	</script>
</BaseLayout>
